{
  "project": {
    "name": "TOSYALI_TRANSFER_OCR",
    "pipeline_version": "8.0",
    "purpose": "Extraction réglementaire structurée de dossiers PDF de transferts libres, y compris PDF natifs et PDF scannés sous forme d'images.",
    "target_volume": {
      "number_of_dossiers": 1000,
      "processing_mode": "ONE_SHOT_BATCH",
      "average_pages_per_dossier": 4
    },
    "priority_order": [
      "QUALITE_EXTRACTION",
      "TRACABILITE",
      "COHERENCE_INTER_DOCUMENTS",
      "VITESSE",
      "CONSOMMATION_TOKENS"
    ]
  },

  "hardware": {
    "gpu": "NVIDIA H100 80GB",
    "gpu_count": 1,
    "flash_attention_available": false,
    "mixed_precision": "BF16",
    "quantization": "FP8",
    "model_residency": "KEEP_MODEL_LOADED_FOR_ENTIRE_BATCH",
    "torch_empty_cache_policy": "ONLY_ON_OOM_OR_FATAL_ERROR"
  },

  "model": {
    "primary_model": "Qwen3.6-35B-A3B-FP8",
    "secondary_model": null,
    "use_single_model_only": true,
    "trust_remote_code": true,
    "low_cpu_mem_usage": true,
    "device_map": {
      "": 0
    },
    "model_eval": true,
    "generation": {
      "do_sample": false,
      "temperature": 0.0,
      "top_p": 1.0,
      "use_cache": true
    }
  },

  "performance": {
    "classification": {
      "batch_size_initial": 12,
      "batch_size_min": 4,
      "batch_size_max": 16,
      "max_side_px": 640,
      "max_new_tokens": 32
    },
    "extraction": {
      "batch_size_initial": 4,
      "batch_size_min": 1,
      "batch_size_max": 6,
      "max_side_px": 1400,
      "max_new_tokens": 700
    },
    "targeted_retry": {
      "batch_size": 1,
      "max_side_px": 2000,
      "max_new_tokens": 300,
      "maximum_retries_per_page": 2
    },
    "oom_recovery": {
      "enabled": true,
      "actions": [
        "CLEAR_FAILED_BATCH_REFERENCES",
        "GC_COLLECT",
        "TORCH_CUDA_EMPTY_CACHE",
        "HALVE_BATCH_SIZE",
        "RETRY_BATCH"
      ],
      "minimum_extraction_batch_size": 1
    }
  },

  "pdf_ingestion": {
    "supported_extensions": [
      ".pdf",
      ".PDF"
    ],
    "detect_native_text": true,
    "detect_scan_only_pdf": true,
    "native_text_policy": "USE_AS_AUXILIARY_SIGNAL_ONLY",
    "vision_remains_authoritative": true,
    "render_backend": "PYMUPDF",
    "default_zoom": 1.6,
    "preserve_aspect_ratio": true,
    "image_mode": "RGB",
    "skip_nearly_blank_pages": true,
    "blank_page_threshold": 0.995
  },

  "document_types": [
    "ENGAGEMENT_DOMICILIATION",
    "CONTRAT_TRAVAIL",
    "CONTRAT_SPECIFIQUE",
    "TITRE_TRAVAIL",
    "PERMIS_TRAVAIL_COUVERTURE",
    "AUTRE"
  ],

  "classification": {
    "prompt": "Classe uniquement cette page. Valeurs autorisées: ENGAGEMENT_DOMICILIATION, CONTRAT_TRAVAIL, CONTRAT_SPECIFIQUE, TITRE_TRAVAIL, PERMIS_TRAVAIL_COUVERTURE, AUTRE. Retourne uniquement un JSON strict: {\"type_document\":\"...\",\"confidence\":0.00,\"bloc_identite_present\":false}.",
    "confidence_threshold": 0.70,
    "rules": [
      {
        "if": {
          "bloc_identite_present": true,
          "type_document_in": [
            "PERMIS_TRAVAIL_COUVERTURE",
            "AUTRE"
          ]
        },
        "force_type": "TITRE_TRAVAIL"
      }
    ]
  },

  "global_extraction_rules": {
    "output_json_only": true,
    "no_markdown": true,
    "no_explanations": true,
    "never_invent": true,
    "unreadable_value": null,
    "preserve_raw_text_when_requested": true,
    "respect_document_value_over_inference": true,
    "do_not_calculate_missing_document_values": true,
    "do_not_correct_names_using_external_knowledge": true,
    "identifiers_are_strings": true
  },

  "schemas": {
    "ENGAGEMENT_DOMICILIATION": {
      "fields": {
        "DOM_NOM_RAISON_SOCIAL_CLIENT": "string",
        "DOM_COMPTE_LOCAL": "identifier",
        "DOM_ADRESSE_CLIENT": "string",
        "DOM_AGENCE_DOMICILIATAIRE": "string",
        "DOM_NUMERO_CONTRAT": "identifier",
        "DOM_DUREE_CONTRAT_MOIS": "integer",
        "DOM_DATE_DEBUT_CONTRAT": "date",
        "DOM_DATE_FIN_CONTRAT": "date",
        "DOM_NOM_RAISON_SOCIAL_EMPLOYEUR": "string",
        "DOM_ADRESSE_EMPLOYEUR": "string",
        "DOM_SALAIRE_NET_MENSUEL": "amount",
        "DOM_PART_TRANSFERABLE": "amount",
        "DOM_TAUX_TRANSFERABLE": "percentage",
        "DOM_MONTANT_TOTAL_DOMICILIE": "amount",
        "DOM_DATE_SIGNATURE": "date"
      },
      "critical_fields": [
        "DOM_NOM_RAISON_SOCIAL_CLIENT",
        "DOM_COMPTE_LOCAL",
        "DOM_NUMERO_CONTRAT",
        "DOM_DATE_DEBUT_CONTRAT",
        "DOM_DATE_FIN_CONTRAT",
        "DOM_SALAIRE_NET_MENSUEL",
        "DOM_PART_TRANSFERABLE"
      ]
    },

    "CONTRAT_TRAVAIL": {
      "fields": {
        "CTR_REFERENCE_DOCUMENT": "identifier",
        "CTR_TYPE": "string",
        "CTR_EMPLOYEUR": "string",
        "CTR_ACTIVITE_EMPLOYEUR": "string",
        "CTR_DUREE_MOIS": "integer",
        "CTR_DATE_DEBUT_CONTRAT": "date",
        "CTR_POSTE": "string",
        "CTR_NOM_PRENOM_TRAVAILLEUR": "string",
        "CTR_PERE_NOM_PRENOM": "string",
        "CTR_MERE_NOM_PRENOM": "string",
        "CTR_NATIONALITE": "string",
        "CTR_DATE_NAISSANCE": "date",
        "CTR_LIEU_PAYS_NAISSANCE": "string",
        "CTR_ADRESSE_ALGERIE": "string",
        "CTR_QUALIFICATION": "string",
        "CTR_NUMERO_PERMIS_TRAVAIL": "identifier",
        "CTR_DATE_DELIVRANCE_PERMIS": "date",
        "CTR_DATE_DEBUT_VALIDITE_PERMIS": "date",
        "CTR_DATE_FIN_VALIDITE_PERMIS": "date",
        "CTR_SALAIRE_BRUT": "amount",
        "CTR_SALAIRE_NET": "amount",
        "CTR_AFFILIATION_SS": "string",
        "CTR_NUMERO_EMPLOYEUR": "identifier",
        "CTR_DATE_SIGNATURE": "date",
        "CTR_REFERENCE_DOMICILIATION": "identifier",
        "CTR_SIGNATURE_TRAVAILLEUR_PRESENTE": "boolean",
        "CTR_SIGNATURE_EMPLOYEUR_PRESENTE": "boolean",
        "CTR_CACHET_EMPLOYEUR_PRESENT": "boolean"
      },
      "critical_fields": [
        "CTR_EMPLOYEUR",
        "CTR_DUREE_MOIS",
        "CTR_DATE_DEBUT_CONTRAT",
        "CTR_NOM_PRENOM_TRAVAILLEUR",
        "CTR_NUMERO_PERMIS_TRAVAIL",
        "CTR_DATE_FIN_VALIDITE_PERMIS",
        "CTR_SALAIRE_NET"
      ]
    },

    "CONTRAT_SPECIFIQUE": {
      "fields": {
        "CTS_REFERENCE_DOCUMENT": "identifier",
        "CTS_SAP_ID": "identifier",
        "CTS_EMPLOYEUR": "string",
        "CTS_ACTIVITE_EMPLOYEUR": "string",
        "CTS_DUREE_MOIS": "integer",
        "CTS_DATE_DEBUT_CONTRAT": "date",
        "CTS_POSTE": "string",
        "CTS_NOM_PRENOM_TRAVAILLEUR": "string",
        "CTS_PERE_NOM_PRENOM": "string",
        "CTS_MERE_NOM_PRENOM": "string",
        "CTS_NATIONALITE": "string",
        "CTS_DATE_NAISSANCE": "date",
        "CTS_LIEU_PAYS_NAISSANCE": "string",
        "CTS_ADRESSE_ALGERIE": "string",
        "CTS_QUALIFICATION": "string",
        "CTS_NUMERO_PERMIS_TRAVAIL": "identifier",
        "CTS_DATE_DELIVRANCE_PERMIS": "date",
        "CTS_DATE_DEBUT_VALIDITE_PERMIS": "date",
        "CTS_DATE_FIN_VALIDITE_PERMIS": "date",
        "CTS_LIGNE_SALAIRE_BRUTE": "raw_string",
        "CTS_SALAIRE_NET": "amount",
        "CTS_SALAIRE_NET_ANCIEN": "amount",
        "CTS_MENTION_AU_LIEU_DE_PRESENTE": "boolean",
        "CTS_PART_TRANSFERABLE": "amount",
        "CTS_PART_PAYABLE_DZD": "amount",
        "CTS_NUMERO_SS_PAYS_ORIGINE": "identifier",
        "CTS_NUMERO_SS_ALGERIE": "identifier",
        "CTS_DATE_DOCUMENT": "date",
        "CTS_SIGNATURE_TRAVAILLEUR_PRESENTE": "boolean",
        "CTS_SIGNATURE_EMPLOYEUR_PRESENTE": "boolean",
        "CTS_CACHET_EMPLOYEUR_PRESENT": "boolean",
        "CTS_VISA_INSPECTION_TRAVAIL_PRESENT": "boolean"
      },
      "critical_fields": [
        "CTS_EMPLOYEUR",
        "CTS_DATE_DEBUT_CONTRAT",
        "CTS_NOM_PRENOM_TRAVAILLEUR",
        "CTS_NUMERO_PERMIS_TRAVAIL",
        "CTS_DATE_FIN_VALIDITE_PERMIS",
        "CTS_SALAIRE_NET",
        "CTS_PART_TRANSFERABLE"
      ]
    },

    "TITRE_TRAVAIL": {
      "fields": {
        "TTR_NUMERO_PERMIS": "identifier",
        "TTR_NUMERO_MANUSCRIT": "identifier",
        "TTR_POSTE": "string",
        "TTR_DUREE": "string",
        "TTR_DATE_DEBUT": "date",
        "TTR_DATE_FIN": "date",
        "TTR_LIEU_TRAVAIL": "string",
        "TTR_EMPLOYEUR": "string",
        "TTR_ADRESSE_EMPLOYEUR": "string",
        "TTR_FAIT_A": "string",
        "TTR_DATE_DELIVRANCE": "date",
        "TTR_NOM": "string",
        "TTR_PRENOM": "string",
        "TTR_DATE_NAISSANCE": "date",
        "TTR_LIEU_NAISSANCE": "string",
        "TTR_PAYS": "string",
        "TTR_NATIONALITE": "string",
        "TTR_QUALIFICATION": "string",
        "TTR_DATE_ENTREE_ALGERIE": "date",
        "TTR_PHOTO_PRESENTE": "boolean",
        "TTR_CACHET_PRESENT": "boolean"
      },
      "critical_fields": [
        "TTR_NUMERO_PERMIS",
        "TTR_NOM",
        "TTR_PRENOM",
        "TTR_DATE_NAISSANCE",
        "TTR_DATE_DEBUT",
        "TTR_DATE_FIN"
      ]
    },

    "PERMIS_TRAVAIL_COUVERTURE": {
      "fields": {
        "PTR_NUMERO_SERIE": "identifier",
        "PTR_WILAYA": "string",
        "PTR_CACHET_DIRECTION_EMPLOI_PRESENT": "boolean"
      },
      "critical_fields": []
    }
  },

  "normalization": {
    "principle": "ALWAYS_KEEP_RAW_AND_NORMALIZED_VALUES_FOR_REGULATORY_TRACEABILITY",

    "amount": {
      "output_type": "number",
      "decimal_places": 2,
      "currency_default": "DZD",
      "thousands_separator_in_json": false,
      "decimal_separator_in_json": ".",
      "accepted_input_examples": [
        "506 471,38",
        "506.471,38",
        "506,471.38",
        "506471,38",
        "506471.38"
      ],
      "normalized_example": {
        "raw": "506 471,38",
        "value": 506471.38,
        "currency": "DZD"
      },
      "rules": [
        "REMOVE_NON_BREAKING_SPACES",
        "REMOVE_CURRENCY_LABELS",
        "DETECT_DECIMAL_SEPARATOR_FROM_LAST_SEPARATOR",
        "REMOVE_THOUSANDS_SEPARATORS",
        "CONVERT_TO_DECIMAL_POINT",
        "ROUND_TO_2_DECIMALS",
        "NEVER_CONVERT_AMOUNT_TO_INTEGER"
      ]
    },

    "percentage": {
      "output_type": "number",
      "decimal_places": 4,
      "representation": "PERCENT_NOT_RATIO",
      "example": {
        "raw": "95%",
        "value": 95.0
      }
    },

    "date": {
      "output_type": "string",
      "format": "YYYY-MM-DD",
      "accepted_input_formats": [
        "DD/MM/YYYY",
        "DD-MM-YYYY",
        "DD.MM.YYYY",
        "YYYY-MM-DD"
      ],
      "example": {
        "raw": "13/10/2025",
        "value": "2025-10-13"
      },
      "invalid_or_ambiguous_policy": "NULL_AND_FLAG",
      "never_guess_missing_day_or_month": true
    },

    "integer": {
      "output_type": "integer",
      "rules": [
        "REMOVE_SPACES",
        "REMOVE_NON_NUMERIC_DECORATION",
        "REJECT_DECIMAL_VALUE_UNLESS_SEMANTICALLY_INTEGER"
      ],
      "example": {
        "raw": "24 Mois",
        "value": 24
      }
    },

    "identifier": {
      "output_type": "string",
      "reason": "Identifiers must never be converted to numeric types because leading zeros and formatting are significant.",
      "preserve_leading_zeros": true,
      "trim_outer_spaces": true,
      "remove_internal_spaces_only_when_field_rule_allows": true,
      "never_scientific_notation": true,
      "examples": [
        {
          "field": "DOM_COMPTE_LOCAL",
          "raw": "02700731011032700188",
          "value": "02700731011032700188"
        },
        {
          "field": "TTR_NUMERO_PERMIS",
          "raw": "21-00002974/31-25-001448",
          "value": "21-00002974/31-25-001448"
        }
      ]
    },

    "boolean": {
      "output_type": "boolean",
      "allowed_values": [
        true,
        false,
        null
      ],
      "rule": "Use null when visual evidence is insufficient."
    },

    "string": {
      "output_type": "string",
      "unicode_normalization": "NFC",
      "trim": true,
      "collapse_repeated_spaces": true,
      "preserve_accents": true,
      "preserve_arabic": true,
      "uppercase_names": false,
      "do_not_translate": true
    }
  },

  "field_traceability": {
    "enabled": true,
    "store_for_each_field": {
      "raw_value": true,
      "normalized_value": true,
      "source_file": true,
      "source_page": true,
      "document_type": true,
      "extraction_strategy": true,
      "validation_status": true
    },
    "field_record_example": {
      "field": "DOM_PART_TRANSFERABLE",
      "raw_value": "481 147,81",
      "normalized_value": 481147.81,
      "source_file": "YILDIRIM_IBRAHIM.pdf",
      "source_page": 1,
      "document_type": "ENGAGEMENT_DOMICILIATION",
      "extraction_strategy": "STANDARD",
      "validation_status": "VALID"
    }
  },

  "extraction_strategy": {
    "standard_pass": {
      "enabled": true,
      "one_pass_per_page": true,
      "use_full_page": true,
      "max_side_px": 1400
    },

    "retry_trigger": {
      "retry_only_if": [
        "CRITICAL_FIELD_MISSING",
        "INVALID_FORMAT",
        "INTER_DOCUMENT_CONFLICT",
        "UNREADABLE_CRITICAL_IDENTIFIER"
      ],
      "do_not_retry_for": [
        "OPTIONAL_FIELD_MISSING",
        "LEGITIMATE_NULL_VALUE"
      ]
    },

    "targeted_retry_by_document": {
      "TITRE_TRAVAIL": {
        "identity_crop": {
          "crop": "DYNAMIC_TOP_RIGHT",
          "fields": [
            "TTR_NOM",
            "TTR_PRENOM",
            "TTR_DATE_NAISSANCE",
            "TTR_LIEU_NAISSANCE",
            "TTR_PAYS",
            "TTR_NATIONALITE",
            "TTR_QUALIFICATION",
            "TTR_DATE_ENTREE_ALGERIE"
          ]
        },
        "employment_crop": {
          "crop": "DYNAMIC_TOP_LEFT",
          "fields": [
            "TTR_NUMERO_PERMIS",
            "TTR_POSTE",
            "TTR_DUREE",
            "TTR_DATE_DEBUT",
            "TTR_DATE_FIN",
            "TTR_LIEU_TRAVAIL",
            "TTR_EMPLOYEUR",
            "TTR_ADRESSE_EMPLOYEUR"
          ]
        }
      },

      "CONTRAT_SPECIFIQUE": {
        "salary_crop": {
          "crop": [
            0.20,
            0.68,
            0.00,
            1.00
          ],
          "fields": [
            "CTS_LIGNE_SALAIRE_BRUTE",
            "CTS_SALAIRE_NET",
            "CTS_SALAIRE_NET_ANCIEN",
            "CTS_PART_TRANSFERABLE",
            "CTS_PART_PAYABLE_DZD"
          ]
        }
      }
    },

    "forbidden_retry_strategy": [
      "FULL_PAGE_HD_AS_DEFAULT_RETRY",
      "REPEAT_IDENTICAL_PROMPT_AND_IMAGE",
      "OVERWRITE_VALID_EXISTING_VALUE_WITH_RETRY"
    ],

    "retry_merge_policy": "ONLY_FILL_NULL_OR_INVALID_FIELDS"
  },

  "validation": {
    "format_validation": {
      "dates": true,
      "amounts": true,
      "integers": true,
      "percentages": true,
      "account_numbers": true,
      "permit_numbers": true
    },

    "business_rules": [
      {
        "id": "DATE_CONTRACT_ORDER",
        "rule": "DATE_FIN_CONTRAT >= DATE_DEBUT_CONTRAT",
        "severity": "ERROR"
      },
      {
        "id": "PERMIT_DATE_ORDER",
        "rule": "DATE_FIN_VALIDITE_PERMIS >= DATE_DEBUT_VALIDITE_PERMIS",
        "severity": "ERROR"
      },
      {
        "id": "TRANSFER_NOT_GREATER_THAN_NET_SALARY",
        "rule": "PART_TRANSFERABLE <= SALAIRE_NET",
        "severity": "ERROR"
      },
      {
        "id": "TRANSFER_RATE_REASONABLE",
        "rule": "0 <= TAUX_TRANSFERABLE <= 100",
        "severity": "ERROR"
      }
    ]
  },

  "cross_document_controls": {
    "enabled": true,
    "identity": {
      "compare": [
        "CTR_NOM_PRENOM_TRAVAILLEUR",
        "CTS_NOM_PRENOM_TRAVAILLEUR",
        "TTR_NOM + TTR_PRENOM",
        "DOM_NOM_RAISON_SOCIAL_CLIENT"
      ],
      "normalization_for_comparison": [
        "UPPERCASE",
        "REMOVE_DIACRITICS_FOR_COMPARISON_ONLY",
        "COLLAPSE_SPACES"
      ],
      "retain_original_text": true
    },

    "contract_dates": {
      "compare": [
        "DOM_DATE_DEBUT_CONTRAT",
        "CTR_DATE_DEBUT_CONTRAT",
        "CTS_DATE_DEBUT_CONTRAT",
        "TTR_DATE_DEBUT"
      ]
    },

    "permit_number": {
      "compare": [
        "TTR_NUMERO_PERMIS",
        "CTR_NUMERO_PERMIS_TRAVAIL",
        "CTS_NUMERO_PERMIS_TRAVAIL"
      ]
    },

    "salary": {
      "new_salary_priority": [
        "CTS_SALAIRE_NET",
        "CTR_SALAIRE_NET",
        "DOM_SALAIRE_NET_MENSUEL"
      ],
      "detect_old_salary_from": [
        "CTS_SALAIRE_NET_ANCIEN",
        "CTS_LIGNE_SALAIRE_BRUTE"
      ],
      "tolerance_dzd": 0.01
    },

    "transferable_amount": {
      "compare": [
        "DOM_PART_TRANSFERABLE",
        "CTS_PART_TRANSFERABLE"
      ],
      "tolerance_dzd": 0.01
    }
  },

  "salary_change_logic": {
    "enabled": true,
    "raw_line_field": "CTS_LIGNE_SALAIRE_BRUTE",
    "new_salary_field": "CTS_SALAIRE_NET",
    "old_salary_field": "CTS_SALAIRE_NET_ANCIEN",
    "trigger_expression": "au lieu de",
    "outputs": [
      "SALAIRE_ANCIEN",
      "SALAIRE_NOUVEAU_AUGMENTE",
      "AUGMENTATION_DETECTEE",
      "SENS_VARIATION_SALAIRE",
      "MONTANT_AUGMENTATION",
      "TAUX_AUGMENTATION_PCT",
      "SOURCE_AUGMENTATION",
      "ECART_SALAIRE_DOM_CONTRAT",
      "COHERENCE_SALAIRE_DOM_CONTRAT",
      "ALERTE_DOM_SUR_ANCIEN_SALAIRE"
    ]
  },

  "consolidated_reference_fields": {
    "NOM_TRAVAILLEUR_REFERENCE": {
      "priority": [
        "CTR_NOM_PRENOM_TRAVAILLEUR",
        "CTS_NOM_PRENOM_TRAVAILLEUR",
        "TTR_NOM + TTR_PRENOM"
      ]
    },
    "DATE_NAISSANCE_REFERENCE": {
      "priority": [
        "CTR_DATE_NAISSANCE",
        "CTS_DATE_NAISSANCE",
        "TTR_DATE_NAISSANCE"
      ]
    },
    "NATIONALITE_REFERENCE": {
      "priority": [
        "CTR_NATIONALITE",
        "CTS_NATIONALITE",
        "TTR_NATIONALITE"
      ]
    },
    "NUMERO_CONTRAT_REFERENCE": {
      "priority": [
        "DOM_NUMERO_CONTRAT",
        "CTR_REFERENCE_DOCUMENT",
        "CTS_REFERENCE_DOCUMENT"
      ]
    },
    "DATE_DEBUT_CONTRAT_REFERENCE": {
      "priority": [
        "DOM_DATE_DEBUT_CONTRAT",
        "CTR_DATE_DEBUT_CONTRAT",
        "CTS_DATE_DEBUT_CONTRAT"
      ]
    },
    "DATE_FIN_CONTRAT_REFERENCE": {
      "priority": [
        "DOM_DATE_FIN_CONTRAT",
        "CTR_DATE_FIN_VALIDITE_PERMIS",
        "CTS_DATE_FIN_VALIDITE_PERMIS",
        "TTR_DATE_FIN"
      ]
    },
    "NUMERO_PERMIS_REFERENCE": {
      "priority": [
        "TTR_NUMERO_PERMIS",
        "CTR_NUMERO_PERMIS_TRAVAIL",
        "CTS_NUMERO_PERMIS_TRAVAIL",
        "PTR_NUMERO_SERIE"
      ]
    }
  },

  "quality_status": {
    "possible_values": [
      "VALID",
      "VALID_WITH_WARNINGS",
      "MANUAL_REVIEW_REQUIRED",
      "TECHNICAL_ERROR"
    ],
    "rules": {
      "VALID": "All critical fields valid and all blocking cross-document controls pass.",
      "VALID_WITH_WARNINGS": "All critical fields valid but at least one non-blocking discrepancy exists.",
      "MANUAL_REVIEW_REQUIRED": "At least one critical field remains missing, invalid or conflicting after targeted retry.",
      "TECHNICAL_ERROR": "PDF rendering, model inference or JSON parsing failed after technical retry."
    }
  },

  "output": {
    "formats": [
      "JSON",
      "XLSX"
    ],

    "json_encoding": "UTF-8",

    "files": {
      "master_json": "domiciliations_master.json",
      "checkpoint_directory": "checkpoints",
      "excel_output": "resultats_tosyali.xlsx"
    },

    "excel_sheets": [
      "DOMICILIATIONS",
      "DOCUMENTS",
      "CHAMPS_SOURCE",
      "ERREURS",
      "PARAMETRES"
    ],

    "dossier_json_structure": {
      "source_file": "string",
      "source_sha256": "string",
      "pipeline_version": "string",
      "processing_status": "string",
      "quality_status": "string",
      "stats": {
        "pages": "integer",
        "tokens_in": "integer",
        "tokens_out": "integer",
        "tokens_total": "integer",
